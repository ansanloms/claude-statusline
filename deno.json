{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "version": "0.1.0",
  "lint": {
    "rules": { "tags": ["recommended"] },
    "plugins": ["jsr:@aireone/deno-lint-curly"]
  },
  "imports": {
    "@gunshi/gunshi": "jsr:@gunshi/gunshi@0.37.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.32",
    "@std/fmt": "jsr:@std/fmt@1.0.10",
    "@std/path": "jsr:@std/path@1.1.5"
  },
  "tasks": {
    "test": "deno test -A --parallel --coverage",
    "check": "deno check",
    "lint": "deno lint && deno fmt --check",
    "fix": "deno lint --fix && deno fmt",
    "build": "deno bundle --output dist/claude-statusline statusline.ts && chmod +x dist/claude-statusline"
  }
}
